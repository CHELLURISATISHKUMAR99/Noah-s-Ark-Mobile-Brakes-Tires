# Optional analytics. The site loads a tag only when the value matches a real ID.
# Leave both blank until the shop has a GA4 property or a Meta Pixel.
# GA4 measurement IDs start with G-.
# Meta Pixel IDs are numeric.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# Public Google Business Profile URL. Leave blank until the owner shares it.
# The reviews section stays on the page either way, and it never shows a star rating.
VITE_GOOGLE_BUSINESS_URL=
